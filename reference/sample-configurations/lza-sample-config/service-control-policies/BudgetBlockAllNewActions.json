{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNewComputeAndStartActions",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:RebootInstances",
        "ec2:Create*",
        "autoscaling:Create*",
        "autoscaling:Start*",
        "rds:Create*",
        "rds:Start*",
        "eks:Create*",
        "eks:Update*",
        "lambda:Create*",
        "lambda:InvokeFunction",
        "batch:SubmitJob",
        "ecs:RunTask",
        "ecs:StartTask",
        "elasticbeanstalk:Create*",
        "elasticbeanstalk:UpdateEnvironment",
        "lightsail:Create*",
        "sagemaker:Create*",
        "sagemaker:Start*",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    }
  ]
}